{
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://opsmindflow.onrender.com/api/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "https://opsmindflow.onrender.com/auth/$1"
    },
    {
      "src": "/health",
      "dest": "https://opsmindflow.onrender.com/health"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}